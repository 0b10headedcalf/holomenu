# HoloMenu env — copy to .env.local. App works fully offline without any of these.
# Meta Model API (Muse Spark for scan + chat, SAM 3.1 on Modal)
META_API_KEY=
META_API_BASE_URL=
META_MODEL=muse-spark

# Modal GPU reconstruction endpoint (from `modal deploy modal/reconstruct.py`)
MODAL_ENDPOINT_URL=
